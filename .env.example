# NEXUS Phase 0 — copy to .env and adjust. No real secrets required for local dry-run.

# Postgres connection (matches docker-compose defaults)
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus

# Optional overrides
# PGHOST=localhost
# PGPORT=5432
# PGUSER=nexus
# PGPASSWORD=nexus
# PGDATABASE=nexus

# Dry-run / spend gate: keep false so CLI never spends
NEXUS_ALLOW_SPEND=false

# Log level: debug | info | warn | error
LOG_LEVEL=info
